// Writes supabase/seed/places.sql from docs/venue/locations.md (D-043), so the venue's places can be loaded with
// `supabase db push --include-seed`. Places are matched by their number: a re-run updates name, building, floor,
// hiding spot and landmark, and never touches clue sets or pins set in the admin panel.
//
//   npx tsx scripts/places-sql.mts [md]      (default docs/venue/locations.md)
import { readFileSync, writeFileSync } from "node:fs";

const path = process.argv[2] ?? "docs/venue/locations.md";
const none = (v: string) => (v === "—" || v === "" ? null : v);
const places = readFileSync(path, "utf8")
  .split("\n")
  .filter((l) => /^\| \d+ \|/.test(l))
  .map((l) => {
    const [no, building, floor, name, hide, , , landmark] = l.split("|").slice(1, -1).map((c) => c.trim());
    return { place_no: Number(no), building, floor, name, notes: none(hide!), landmark: none(landmark!) };
  });

const problems: string[] = [];
places.forEach((p, i) => {
  if (p.place_no !== i + 1) problems.push(`row ${i + 1}: numbered ${p.place_no}`);
  if (!p.name || p.name.length > 80) problems.push(`#${p.place_no}: name must be 1–80 characters`);
  if (!p.building || p.building.length > 60) problems.push(`#${p.place_no}: building must be 1–60 characters`);
  if (!p.floor || p.floor.length > 30) problems.push(`#${p.place_no}: floor must be 1–30 characters`);
  if ((p.notes?.length ?? 0) > 200) problems.push(`#${p.place_no}: hiding spot over 200 characters`);
  if ((p.landmark?.length ?? 0) > 160) problems.push(`#${p.place_no}: landmark over 160 characters`);
});
if (!places.length) problems.push("no places found");
if (problems.length) {
  console.error(problems.join("\n"));
  process.exit(1);
}

const json = JSON.stringify(places);
if (json.includes("$places$")) throw new Error("the list contains the SQL quote tag");
const sql = `-- Generated by scripts/places-sql.mts from ${path} (${places.length} places). Do not edit by hand.
insert into public.locations (place_no, building, floor, name, notes, landmark)
select (p ->> 'place_no')::int, p ->> 'building', p ->> 'floor', p ->> 'name', p ->> 'notes', p ->> 'landmark'
from jsonb_array_elements($places$${json}$places$::jsonb) p
on conflict (place_no) do update
  set building = excluded.building, floor = excluded.floor, name = excluded.name,
      notes = excluded.notes, landmark = excluded.landmark;
`;
writeFileSync("supabase/seed/places.sql", sql);
console.log(`supabase/seed/places.sql: ${places.length} places`);
