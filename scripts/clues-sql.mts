// Writes supabase/seed/clues.sql from docs/venue/clues.md (T-503): every place's clue sets, matched to the place by
// its number, so they load with `supabase db push --include-seed`. The CLI runs a seed file only once: after the
// first load, change clues in the admin panel (Locations › Clue 1 / 2 / 3) or with a migration.
//
//   npx tsx scripts/clues-sql.mts [md]      (default docs/venue/clues.md)
import { readFileSync, writeFileSync } from "node:fs";

const path = process.argv[2] ?? "docs/venue/clues.md";
const sets: { place_no: number; set_no: number; pieces: string[]; hint: string }[] = [];
const problems: string[] = [];
let place: number | null = null;
for (const line of readFileSync(path, "utf8").split("\n")) {
  const head = line.match(/^## #(\d+) · /);
  if (head) place = Number(head[1]);
  const row = line.match(/^\| (\d) \| (.+) \|$/);
  if (!row || place === null) continue;
  const cells = row[2]!.split(" | ").map((c) => c.trim());
  if (cells.length !== 5) problems.push(`#${place} set ${row[1]}: expected 4 pieces and a hint, got ${cells.length} cells`);
  const [a, b, c, d, hint] = cells;
  const pieces = [a!, b!, c!, d!];
  if (pieces.some((p) => !p || p.length > 200)) problems.push(`#${place} set ${row[1]}: every piece is 1–200 characters`);
  if (!hint || hint.length > 300) problems.push(`#${place} set ${row[1]}: the hint is 1–300 characters`);
  sets.push({ place_no: place, set_no: Number(row[1]), pieces, hint: hint! });
}
if (!sets.length) problems.push("no clue sets found");
if (problems.length) {
  console.error(problems.join("\n"));
  process.exit(1);
}

const json = JSON.stringify(sets);
if (json.includes("$clues$")) throw new Error("the clues contain the SQL quote tag");
const sql = `-- Generated by scripts/clues-sql.mts from ${path} (${sets.length} clue sets). Do not edit by hand.
insert into public.clue_sets (location_id, set_no, pieces, hint)
select l.id, (s ->> 'set_no')::int, array(select jsonb_array_elements_text(s -> 'pieces')), s ->> 'hint'
from jsonb_array_elements($clues$${json}$clues$::jsonb) s
join public.locations l on l.place_no = (s ->> 'place_no')::int
on conflict (location_id, set_no) do update set pieces = excluded.pieces, hint = excluded.hint;
`;
writeFileSync("supabase/seed/clues.sql", sql);
console.log(`supabase/seed/clues.sql: ${sets.length} clue sets for ${new Set(sets.map((s) => s.place_no)).size} places`);
