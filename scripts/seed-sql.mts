// Writes supabase/seed.sql from the seed question bank (T-502), using the app's own import rules, so the bank can be
// loaded with `supabase db push --include-seed` (or `db reset` locally). Questions already in the table (same text)
// are skipped, so running it twice adds nothing.
//
//   npx tsx scripts/seed-sql.mts [csv]      (default supabase/seed/questions.csv)
import { readFileSync, writeFileSync } from "node:fs";
import { importQuestions } from "../src/lib/admin/questions";

const path = process.argv[2] ?? "supabase/seed/questions.csv";
const report = importQuestions(readFileSync(path, "utf8"));
const bad = report.rows.filter((r) => r.errors.length);
if (report.problem || bad.length) {
  console.error(report.problem ?? bad.map((r) => `line ${r.line}: ${r.errors.join(" ")}`).join("\n"));
  process.exit(1);
}

const json = JSON.stringify(report.valid);
if (json.includes("$bank$")) throw new Error("the bank contains the SQL quote tag");
const sql = `-- Generated by scripts/seed-sql.mts from ${path} (${report.valid.length} questions). Do not edit by hand.
insert into public.questions (text, format, options, answer, alternatives, hint, difficulty, category)
select q ->> 'text', q ->> 'format', nullif(q -> 'options', 'null'::jsonb), q ->> 'answer',
       array(select jsonb_array_elements_text(coalesce(q -> 'alternatives', '[]'))),
       q ->> 'hint', (q ->> 'difficulty')::int, q ->> 'category'
from jsonb_array_elements($bank$${json}$bank$::jsonb) q
where not exists (select 1 from public.questions x where x.text = q ->> 'text');
`;
writeFileSync("supabase/seed.sql", sql);
console.log(`supabase/seed.sql: ${report.valid.length} questions`);
