# Copy to .env.local and fill in. Never commit real values.

# Supabase production project (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: the live site players' QR codes point at (join QR, code slips, printed cards), e.g. https://crypto-hunt.vercel.app
NEXT_PUBLIC_SITE_URL=

# Supabase test project (integration tests and scripts/simulate.ts only)
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
